{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "omnimail-core",
  "main": "./src/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MAIL_BUCKET"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "MAIL_QUEUE",
        "queue": "omnimail-mail"
      }
    ],
    "consumers": [
      {
        "queue": "omnimail-mail",
        "max_batch_size": 1,
        "max_batch_timeout": 2,
        "max_retries": 3,
        "dead_letter_queue": "omnimail-mail-dead"
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
