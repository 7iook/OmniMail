{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "omni-mail",
  "main": "./email-worker/src/index.ts",
  "compatibility_date": "2026-07-27",
  "compatibility_flags": ["nodejs_compat"],
  "keep_vars": true,
  "vars": {
    "CLOUDFLARE_ACCOUNT_ID": "aa3f485e440f2eca7037dfd2b7ba1880",
    "D1_DATABASE_ID": "7dfb47df-dff7-47e0-94e6-ecba5a1b8cb4"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MAIL_BUCKET"
    },
    {
      "binding": "BACKUP_BUCKET",
      "bucket_name": "omni-mail-backups"
    }
  ],
  "workflows": [
    {
      "name": "omni-mail-backup",
      "binding": "BACKUP_WORKFLOW",
      "class_name": "OmniMailBackupWorkflow"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "MAIL_QUEUE",
        "queue": "omnimail-mail"
      }
    ],
    "consumers": [
      {
        "queue": "omnimail-mail",
        "max_batch_size": 1,
        "max_batch_timeout": 2,
        "max_retries": 3,
        "dead_letter_queue": "omnimail-mail-dead"
      }
    ]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
