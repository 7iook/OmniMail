{
  "name": "omnimail",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small, self-hosted webmail deployed as one Cloudflare Worker with Static Assets, D1, R2, Queues, and Resend.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --env-file email-worker/.dev.vars --persist-to .wrangler/state",
    "check:lines": "node scripts/check-file-lines.mjs",
    "check": "npm run check:lines && tsc --noEmit --pretty false && tsc -p email-worker/tsconfig.json --noEmit --pretty false",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "npm run check && vite build"
  },
  "dependencies": {
    "hono": "latest",
    "lucide-react": "latest",
    "postal-mime": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "^1.62.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "latest",
    "typescript": "latest",
    "vite": "latest",
    "vitest": "latest",
    "wrangler": "latest"
  }
}
